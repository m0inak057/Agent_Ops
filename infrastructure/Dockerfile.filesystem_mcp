# Dockerfile for the filesystem_mcp server.
FROM python:3.11-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY mcp_servers/filesystem_mcp/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY mcp_servers/filesystem_mcp/ .

EXPOSE 8002

CMD ["python", "server.py"]
